# Nestora AI backend environment template
#
# Development can continue using SQLite.
# Production should provide a managed PostgreSQL URL.

APP_NAME=Nestora AI Backend
APP_ENV=development

# Local development:
DATABASE_URL=sqlite:///./nestora.db

# Production example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Replace with a strong random secret before production.
AUTH_SECRET_KEY=replace-with-a-strong-random-secret
AUTH_ACCESS_TOKEN_MINUTES=60

# Configure AI provider credentials separately.
GOOGLE_API_KEY=
